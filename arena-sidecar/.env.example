# Internal URL reachable from the sidecar container on the GZCTF compose network.
GZCTF_INTERNAL_URL=http://gzctf:8080
GZCTF_PROFILE_PATH=/api/account/profile
GZCTF_COOKIE_NAME=GZCTF_Token
GZCTF_REQUEST_TIMEOUT_SECONDS=5

ARENA_DATABASE_PATH=/data/arena.db
ARENA_ROOT_PATH=/ctf
# Keep this value stable. Changing it invalidates all stored challenge flags.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ARENA_FLAG_PEPPER=replace-with-a-random-secret-of-at-least-16-characters

# Same-origin deployment needs no CORS origins. Comma-separated when required.
ARENA_CORS_ORIGINS=
ARENA_TRUSTED_HOSTS=HOST,localhost,127.0.0.1

# Emergency local admin is disabled by default; normal administration reuses GZCTF Cookie auth.
ARENA_LOCAL_ADMIN_ENABLED=false
ARENA_LOCAL_ADMIN_USERNAME=Admin
ARENA_LOCAL_ADMIN_PASSWORD_HASH=
ARENA_TOKEN_SECRET=
ARENA_TOKEN_TTL_SECONDS=3600
