# Public HTTP port. Access the platform at http://HOST:HTTP_PORT/ctf/
HTTP_PORT=80
GZCTF_IMAGE=registry.cn-shanghai.aliyuncs.com/gztime/gzctf:develop

# Replace HOST with the server IP. Include :PORT when PUBLIC_ENTRY needs it.
PUBLIC_ENTRY=http://HOST
ARENA_TRUSTED_HOSTS=HOST,localhost,127.0.0.1
ARENA_CORS_ORIGINS=

# Generate independent, high-entropy values before first startup.
POSTGRES_PASSWORD=replace-with-a-long-random-password
GZCTF_ADMIN_PASSWORD=replace-with-a-strong-admin-password
ARENA_FLAG_PEPPER=replace-with-a-stable-random-secret-of-at-least-16-characters

# Optional build metadata.
BUILD_REVISION=local
BUILD_TIMESTAMP=container-build
